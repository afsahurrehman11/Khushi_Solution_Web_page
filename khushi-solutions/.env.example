# ============================================================
# KHUSHI SOLUTIONS — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
#
# PUBLIC variables (NEXT_PUBLIC_*) are safe for client-side code.
# PRIVATE variables are server-side only — never exposed to browsers.
# ============================================================

# ----- PUBLIC: Web3Forms Contact Form -----
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# ----- PUBLIC: Contact & Company Details -----
# These appear in the footer, contact section, and metadata.
NEXT_PUBLIC_CONTACT_EMAIL=support@khushisolutions.com
NEXT_PUBLIC_CONTACT_PHONE=+92 309 567 1234
NEXT_PUBLIC_COMPANY_ADDRESS=Lahore, Pakistan

# ----- PUBLIC: Site URL -----
# ----- PUBLIC: Social Media Links (Optional overrides) -----
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/khushisolutionsofficial
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61574320688638
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/khushisolutions
NEXT_PUBLIC_WHATSAPP_COMMUNITY=https://chat.whatsapp.com/KhushiSolutionsCommunity
