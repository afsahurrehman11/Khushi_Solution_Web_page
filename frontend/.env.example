# ============================================================
# KHUSHI SOLUTIONS — Environment Configuration Example
# ============================================================
# Copy this file to .env.local for local development.
# For production (Netlify), set these variables directly in the Netlify Dashboard!
#
# PUBLIC variables (NEXT_PUBLIC_*) are safe for client-side code.
# ============================================================

# ----- PUBLIC: Web3Forms Contact Form -----
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# ----- PUBLIC: Contact & Company Details -----
NEXT_PUBLIC_CONTACT_EMAIL=contact@khushisolutions.com
NEXT_PUBLIC_CONTACT_PHONE=0566343231
NEXT_PUBLIC_COMPANY_ADDRESS=Sheikhupura, Pakistan

# ----- PUBLIC: Site URL and API URL -----
# For Local Dev: http://localhost:8000
# For Production (Netlify): Set to your Heroku app URL (e.g. https://your-app.herokuapp.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ----- PUBLIC: Social Media Links -----
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/khushisolutionsofficial
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61574320688638
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/khushisolutions
NEXT_PUBLIC_WHATSAPP_COMMUNITY=https://chat.whatsapp.com/KhushiSolutionsCommunity
