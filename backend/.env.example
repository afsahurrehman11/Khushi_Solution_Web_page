# ==============================================================
# KHUSHI SOLUTIONS BACKEND — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. It is listed in .gitignore.

# Application
ENVIRONMENT=development
# Options: development | production
# Mock AssanPay mode is blocked when ENVIRONMENT=production

# CORS (comma-separated, no spaces between origins)
ALLOWED_ORIGINS=http://localhost:3000,https://khushisolutions.com

# MongoDB
# Local dev requires a replica set: mongod --replSet rs0 --bind_ip localhost
# Then in mongo shell: rs.initiate()
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
DATABASE_NAME=ks_company_portal

# AssanPay Credentials (from Merchant Portal → Branches → Rotate API Key)
ASSANPAY_BASE_URL=https://lc-mrcs.assanpay.com
ASSANPAY_MERCHANT_ID=your-merchant-id-here
ASSANPAY_API_KEY=your-api-key-uuid-here
ASSANPAY_API_SECRET=your-api-secret-uuid-here
ASSANPAY_BRANCH_CODE=your-branch-code-here
ASSANPAY_STORE_NAME=Khushi Solutions
ASSANPAY_MOCK=true
# Set ASSANPAY_MOCK=false in production with real credentials
# ASSANPAY_MOCK_RESULT=success
# Options: success | failed | pending (for mock mode testing)

# Notifications (Web3Forms — backend sends admin email after successful payment)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
NOTIFICATION_EMAIL=admin@khushisolutions.com

# Security
SECRET_KEY=replace-with-64-char-random-hex-string-generated-by-secrets-token-hex-32
